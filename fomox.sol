    // 添加内部自动买入函数
     function _autoBuyTokens(address sender, address recipient, uint256 amount) internal{
        require(userInfo[recipient].totalBought == 0, "Already bought");
        require(moPoolContract.getUserAmount(recipient) == 0,"Already in MoPool");
        require(foPoolContract.getUserAmount(recipient) == 0,"Already in FoPool");
        // 计算手续费
        uint256 referralFee = amount * buyFeePercent / 100;
        uint256 buyTechFee = amount * buyTechFeePercent / 100;
        // 将全部代币直接转给接收者，手续费部分除外
        super._transfer(sender, address(fTokenContract), referralFee+buyTechFee); // 将手续费转给合约
        super._transfer(sender, recipient, amount-referralFee-buyTechFee); // 将剩余部分转给用户
        
        // 更新用户信息，不受交换结果影响
        uint256 userReceiverUsdtAmount = getAmountsOut(address(this), usdtAddress, amount - referralFee-buyTechFee);
        userInfo[recipient].lastBuyTimestamp = block.timestamp;
        userInfo[recipient].totalBought = userInfo[recipient].totalBought + userReceiverUsdtAmount;
        
        fTokenContract.processRewards(recipient,referralFee,buyTechFee);
    }
    


